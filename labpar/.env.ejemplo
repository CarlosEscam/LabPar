# Copie este archivo como .env y cambie los valores marcados. Nunca publique el .env con secretos reales.
# Para generar secretos:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#                     o:  openssl rand -base64 48

# --- Obligatorios ---------------------------------------------------------------------------
POSTGRES_PASSWORD=cambie-esta-contrasena
LABPAR_JWT_SECRETO=cambie-este-secreto-de-al-menos-32-caracteres
# Clave de los seudónimos de la investigación: si cambia, los códigos E-XXXXXXXXXX de los estudiantes cambian.
LABPAR_SEUDONIMO_SECRETO=cambie-este-otro-secreto-y-no-lo-modifique-durante-el-estudio

# --- Acceso -----------------------------------------------------------------------------------
LABPAR_PUERTO=8080
# Dirección pública con la que los usuarios abren la plataforma (la misma que escriben en el navegador).
LABPAR_CORS=http://localhost:8080
LABPAR_ADMIN_EMAIL=admin@labpar.local
# Si se deja vacía, se genera una aleatoria y se guarda en el volumen de la API (datos/clave_admin_inicial.txt).
LABPAR_ADMIN_CLAVE=
# true: los estudiantes crean su cuenta con el código del curso. false: las cuentas las crea el administrador.
LABPAR_REGISTRO_ABIERTO=true
# true: crea cuentas y un curso de demostración (no lo use con estudiantes reales).
LABPAR_DEMO=false
LABPAR_JWT_HORAS=12

# --- Institución y tratamiento de datos (Ley 1581 de 2012) -------------------------------------
LABPAR_INSTITUCION=Universidad de Pamplona
LABPAR_CONTACTO_DATOS=

# --- Motor de evaluación ---------------------------------------------------------------------
# Procesos trabajadores por contenedor. Cada uno evalúa un envío a la vez; la medición de rendimiento
# usa el nodo de forma exclusiva, así que más procesos que núcleos/2 no acelera las evaluaciones.
LABPAR_TRABAJADORES=2
LABPAR_TRABAJADORES_GPU=1
LABPAR_MEMORIA_TRABAJADOR=4g
LABPAR_MAX_ENVIOS_SIMULTANEOS=3
LABPAR_TIEMPO_MAXIMO_TRABAJO_S=600
